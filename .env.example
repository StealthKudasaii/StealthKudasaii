# Copie ce fichier en .env et remplis-le. Ne le partage JAMAIS, ne le commit JAMAIS.

# Clé API Claude : https://platform.claude.com (Settings > API keys)
ANTHROPIC_API_KEY=

# Telegram : https://my.telegram.org > API development tools
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# MetaTrader 5 (commence par un compte DÉMO)
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Optionnel : chemin vers terminal64.exe si MT5 n'est pas trouvé automatiquement
MT5_PATH=
