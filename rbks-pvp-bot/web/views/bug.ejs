<%- include('partials/head') %>
<p><a href="/bugs">← Bugs</a></p>
<div class="grid grid-2">
  <div class="card">
    <h2>#<%= b.id %> <%= b.title %> <%- badge(C.BUG_STATUS, b.status) %></h2>
    <p class="muted">Signalé par <%= memberName(b.user_id) %> le <%= fmt(b.created_at) %> • <%= b.platform %></p>
    <h3>Description</h3><div class="answer pre"><%= b.description %></div>
    <% if (b.steps) { %><h3>Étapes pour reproduire</h3><div class="answer pre"><%= b.steps %></div><% } %>
    <% if (files.length) { %><p class="muted">📎 <%= files.length %> pièce(s) jointe(s) : visibles sur le message Discord.</p><% } %>
    <p><b>Pris en charge par :</b> <%= memberName(b.assignee_id) %></p>
    <% if (!b.assignee_id) { %><form method="post" action="/bugs/<%= b.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="assign"><button type="submit">🙋 Prendre en charge</button></form><% } %>
  </div>
  <div>
    <div class="card">
      <h2>🔄 Statut</h2>
      <form method="post" action="/bugs/<%= b.id %>">
        <input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="status">
        <select name="status"><% for (const [k, s] of Object.entries(C.BUG_STATUS)) { %><option value="<%= k %>" <%= b.status === k ? 'selected' : '' %>><%= s.emoji %> <%= s.label %></option><% } %></select>
        <label>Commentaire (historique interne)</label><input type="text" name="comment" maxlength="500">
        <div class="actions"><button class="btn-primary" type="submit">Mettre à jour</button></div>
      </form>
    </div>
    <div class="card">
      <h2>📜 Historique et notes internes</h2>
      <ul class="timeline">
        <% const labels = { created: 'Signalé', status: 'Statut', note: '📝 Note interne' }; for (const e of events) { %>
        <li><b><%= labels[e.action] || e.action %></b> <span class="muted">— <%= fmt(e.created_at) %><%= e.actor_id ? ' par ' + memberName(e.actor_id) : '' %></span><% if (e.content) { %><div class="pre"><%= e.content %></div><% } %></li>
        <% } %>
      </ul>
      <form method="post" action="/bugs/<%= b.id %>"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="op" value="note"><textarea name="content" maxlength="1500" placeholder="Information interne"></textarea><div class="actions"><button type="submit">Ajouter une note</button></div></form>
    </div>
  </div>
</div>
<%- include('partials/foot') %>
