<%- include('partials/head') %>
<div class="card">
  <h2>🗳️ Sondages</h2>
  <% if (!list.length) { %><div class="empty">Aucun sondage.</div><% } %>
  <% for (const p of list) { const total = p.results.counts.reduce((a, b) => a + b, 0); %>
  <details>
    <summary><span>n°<%= p.id %> <b><%= p.question %></b></span><span class="row"><span class="badge"><%= p.results.voters %> votant(s)</span><span class="badge <%= p.status === 'open' ? 'ok' : '' %>"><%= p.status === 'open' ? '🟢 Ouvert' : '🏁 Terminé' %></span></span></summary>
    <% p.opts.forEach((o, i) => { const pct = total ? Math.round(p.results.counts[i] / total * 100) : 0; %>
      <div class="row" style="margin:6px 0"><span style="min-width:200px"><%= o %></span><span class="progress" style="flex:1"><span style="width:<%= pct %>%"></span></span><span class="muted"><%= p.results.counts[i] %> (<%= pct %>%)</span></div>
    <% }) %>
    <p class="muted"><%= p.anonymous ? 'Anonyme' : 'Public' %> • <%= p.multi ? 'Choix multiples' : 'Choix unique' %> • <%= p.ends_at ? 'Fin : ' + fmt(p.ends_at) : 'Fermeture manuelle' %></p>
    <% if (p.status === 'open') { %><form method="post" action="/polls"><input type="hidden" name="_csrf" value="<%= csrf %>"><input type="hidden" name="end" value="<%= p.id %>"><button class="btn-sm" type="submit">Terminer maintenant</button></form><% } %>
  </details>
  <% } %>
</div>
<div class="card">
  <h2>➕ Nouveau sondage</h2>
  <form method="post" action="/polls">
    <input type="hidden" name="_csrf" value="<%= csrf %>">
    <label>Question</label><input type="text" name="question" maxlength="200" required>
    <label>Réponses (une par ligne, 2 à 20)</label><textarea name="options" rows="5" required></textarea>
    <div class="grid grid-2">
      <div><label>Durée (ex. 30m, 2h, 3j — vide = manuelle)</label><input type="text" name="duration" maxlength="10"></div>
      <div><label>Salon</label><%- include('partials/channel-select', { name: 'channel', selected: null }) %></div>
    </div>
    <label class="check"><input type="checkbox" name="multi"> Choix multiples</label>
    <label class="check"><input type="checkbox" name="anonymous" checked> Votes anonymes</label>
    <label class="check"><input type="checkbox" name="live" checked> Résultats visibles pendant le vote</label>
    <div class="actions"><button class="btn-primary" type="submit">Publier</button></div>
  </form>
</div>
<%- include('partials/foot') %>
