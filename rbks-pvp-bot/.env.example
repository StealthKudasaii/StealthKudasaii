# ─────────────────────────────────────────────────────────────
#  RBKS PVP — configuration du bot et du panel
#  Copie ce fichier en « .env » et remplis les valeurs.
#  Ne partage JAMAIS ton fichier .env (il contient des secrets).
# ─────────────────────────────────────────────────────────────

# Portail développeur Discord → ton application → Bot → « Reset Token »
DISCORD_TOKEN=

# Portail développeur → ton application → General Information → Application ID
DISCORD_CLIENT_ID=

# Portail développeur → ton application → OAuth2 → Client Secret (« Reset Secret »)
DISCORD_CLIENT_SECRET=

# Identifiant du serveur RBKS PVP (mode développeur Discord → clic droit sur le serveur → Copier l’identifiant)
GUILD_ID=

# Identifiants Discord ayant toujours un accès total, séparés par des virgules (facultatif, en plus du propriétaire du serveur)
BOT_OWNER_IDS=

# ── Panel web ──
WEB_ENABLED=true
WEB_HOST=0.0.0.0
WEB_PORT=3000
# Adresse publique du panel, SANS « / » final. Doit correspondre à l’URL de redirection OAuth2 (+ /auth/callback).
PUBLIC_URL=http://localhost:3000
# Chaîne aléatoire d’au moins 32 caractères. Générer : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# true si le panel est derrière un reverse proxy (Nginx, Caddy…)
TRUST_PROXY=false

# ── Données ──
DATA_DIR=./data
# DATABASE_PATH=./data/rbks.sqlite
BACKUP_RETENTION=14

# ── Divers ──
TIMEZONE=Europe/Paris
LOG_LEVEL=info
NODE_ENV=production
# Enregistre les commandes slash à chaque démarrage (recommandé)
REGISTER_COMMANDS_ON_START=true

# ── Roblox : /rewards (facultatif) ──
# Liaison des comptes : par défaut, phrase à coller dans la description du profil Roblox (rien à configurer).
# Facultatif, seulement avec un nom de domaine HTTPS : connexion officielle Roblox
# (Creator Dashboard > Credentials > OAuth 2.0 Apps, scopes openid + profile, redirection PUBLIC_URL + /roblox/callback).
ROBLOX_OAUTH_CLIENT_ID=
ROBLOX_OAUTH_CLIENT_SECRET=
# Livraison en jeu : Creator Dashboard > Credentials > API Keys
# (DataStore : lecture/écriture des entrées + Messaging Service : publication, pour ton expérience).
ROBLOX_OPEN_CLOUD_API_KEY=
# Identifiant de l'expérience (Universe ID), visible dans le Creator Dashboard.
ROBLOX_UNIVERSE_ID=
ROBLOX_DATASTORE=RBKSRewards
ROBLOX_MESSAGING_TOPIC=RBKSRewards
